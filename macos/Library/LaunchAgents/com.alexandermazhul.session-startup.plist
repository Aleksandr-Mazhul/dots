<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.alexandermazhul.session-startup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/alexandermazhul/.local/bin/session-startup</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>Nice</key>
  <integer>-20</integer>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>AbandonProcessGroup</key>
  <true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/alexandermazhul</string>
    <key>USER</key>
    <string>alexandermazhul</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/alexandermazhul/Library/Logs/session-startup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/alexandermazhul/Library/Logs/session-startup.log</string>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.alexandermazhul.sketchybar-trigger</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>sleep 3; /opt/homebrew/bin/sketchybar --reload; sleep 1; /opt/homebrew/bin/sketchybar --trigger space_windows_change</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>

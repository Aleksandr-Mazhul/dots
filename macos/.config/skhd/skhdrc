# skhdrc - Simple keyboard hotkey daemon configuration
# AeroSpace-like keybindings: main mode + service mode

:: main @
:: service @

# Focus windows
alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east

# Warp window
alt + shift - h : yabai -m window --warp west
alt + shift - j : yabai -m window --warp south
alt + shift - k : yabai -m window --warp north
alt + shift - l : yabai -m window --warp east

# Resize
alt - 0x1B : yabai -m window --resize left:-8:0; yabai -m window --resize right:-8:0
alt - 0x18 : yabai -m window --resize left:8:0; yabai -m window --resize right:8:0

# Focus display
cmd + alt - h : yabai -m display --focus west
cmd + alt - j : yabai -m display --focus south
cmd + alt - k : yabai -m display --focus north
cmd + alt - l : yabai -m display --focus east

# Move window to display
cmd + alt + shift - h : yabai -m window --display west; yabai -m display --focus west
cmd + alt + shift - j : yabai -m window --display south; yabai -m display --focus south
cmd + alt + shift - k : yabai -m window --display north; yabai -m display --focus north
cmd + alt + shift - l : yabai -m window --display east; yabai -m display --focus east

# Toggle zoom
alt + shift - f : yabai -m window --toggle zoom-fullscreen

# Focus workspaces
alt - w : yabai -m space --focus 1
alt - c : yabai -m space --focus 2
alt - v : yabai -m space --focus 3
alt - d : yabai -m space --focus 4
alt - g : yabai -m space --focus 5
alt - x : yabai -m space --focus 6
alt - z : yabai -m space --focus 7
alt - e : yabai -m space --focus 8
alt - t : yabai -m space --focus 9
alt - i : yabai -m space --focus 10
alt - p : yabai -m space --focus 11
alt - q : yabai -m space --focus 12
alt - u : yabai -m space --focus 13
alt - y : yabai -m space --focus 14
alt - r : yabai -m space --focus 15
alt - a : yabai -m space --focus 16

# Move window to workspace
alt + shift - w : WID=$(yabai -m query --windows --window | jq -r ".id"); yabai -m window --space 1;  yabai -m space --focus 1;  yabai -m window --focus "$WID"
alt + shift - c : WID=$(yabai -m query --windows --window | jq -r ".id"); yabai -m window --space 2;  yabai -m space --focus 2;  yabai -m window --focus "$WID"
alt + shift - v : WID=$(yabai -m query --windows --window | jq -r ".id"); yabai -m window --space 3;  yabai -m space --focus 3;  yabai -m window --focus "$WID"
alt + shift - d : WID=$(yabai -m query --windows --window | jq -r ".id"); yabai -m window --space 4;  yabai -m space --focus 4;  yabai -m window --focus "$WID"
alt + shift - g : WID=$(yabai -m query --windows --window | jq -r ".id"); yabai -m window --space 5;  yabai -m space --focus 5;  yabai -m window --focus "$WID"
alt + shift - x : WID=$(yabai -m query --windows --window | jq -r ".id"); yabai -m window --space 6;  yabai -m space --focus 6;  yabai -m window --focus "$WID"
alt + shift - z : WID=$(yabai -m query --windows --window | jq -r ".id"); yabai -m window --space 7;  yabai -m space --focus 7;  yabai -m window --focus "$WID"
alt + shift - e : WID=$(yabai -m query --windows --window | jq -r ".id"); yabai -m window --space 8;  yabai -m space --focus 8;  yabai -m window --focus "$WID"
alt + shift - t : WID=$(yabai -m query --windows --window | jq -r ".id"); yabai -m window --space 9;  yabai -m space --focus 9;  yabai -m window --focus "$WID"
alt + shift - i : WID=$(yabai -m query --windows --window | jq -r ".id"); yabai -m window --space 10; yabai -m space --focus 10; yabai -m window --focus "$WID"
alt + shift - p : WID=$(yabai -m query --windows --window | jq -r ".id"); yabai -m window --space 11; yabai -m space --focus 11; yabai -m window --focus "$WID"
alt + shift - q : WID=$(yabai -m query --windows --window | jq -r ".id"); yabai -m window --space 12; yabai -m space --focus 12; yabai -m window --focus "$WID"
alt + shift - u : WID=$(yabai -m query --windows --window | jq -r ".id"); yabai -m window --space 13; yabai -m space --focus 13; yabai -m window --focus "$WID"
alt + shift - y : WID=$(yabai -m query --windows --window | jq -r ".id"); yabai -m window --space 14; yabai -m space --focus 14; yabai -m window --focus "$WID"
alt + shift - r : WID=$(yabai -m query --windows --window | jq -r ".id"); yabai -m window --space 15; yabai -m space --focus 15; yabai -m window --focus "$WID"
alt + shift - a : WID=$(yabai -m query --windows --window | jq -r ".id"); yabai -m window --space 16; yabai -m space --focus 16; yabai -m window --focus "$WID"

# Recent workspace
alt - tab : yabai -m space --focus recent

# Service mode
alt + shift - 0x29 : skhd -m service
service < escape : skhd -m main
service < r : yabai -m space --balance; skhd -m main
service < f : yabai -m window --toggle float; skhd -m main
service < delete : yabai -m window --close; skhd -m main
service < h : yabai -m window --stack west; skhd -m main
service < j : yabai -m window --stack south; skhd -m main
service < k : yabai -m window --stack north; skhd -m main
service < l : yabai -m window --stack east; skhd -m main
service < q : skhd -m main
service < return : skhd -m main

# Reload
shift + cmd - r : ~/.config/yabai/scripts/reload.sh

# Swap windows
alt + ctrl - h : yabai -m window --swap west
alt + ctrl - j : yabai -m window --swap south
alt + ctrl - k : yabai -m window --swap north
alt + ctrl - l : yabai -m window --swap east

# skhdrc - Simple keyboard hotkey daemon configuration
# AeroSpace-like keybindings: main mode + service mode

:: main @
:: service @

# Focus windows
alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east

# Warp window
alt + shift - h : yabai -m window --warp west
alt + shift - j : yabai -m window --warp south
alt + shift - k : yabai -m window --warp north
alt + shift - l : yabai -m window --warp east

# Resize
alt - 0x1B : yabai -m window --resize left:-20:0; yabai -m window --resize right:-20:0
alt - 0x18 : yabai -m window --resize left:20:0; yabai -m window --resize right:20:0

# Focus display
cmd + alt - h : yabai -m display --focus west
cmd + alt - j : yabai -m display --focus south
cmd + alt - k : yabai -m display --focus north
cmd + alt - l : yabai -m display --focus east

# Move window to display
cmd + alt + shift - h : yabai -m window --display west; yabai -m display --focus west
cmd + alt + shift - j : yabai -m window --display south; yabai -m display --focus south
cmd + alt + shift - k : yabai -m window --display north; yabai -m display --focus north
cmd + alt + shift - l : yabai -m window --display east; yabai -m display --focus east

# Toggle zoom
alt + shift - f : yabai -m window --toggle zoom-fullscreen

# Focus workspaces
alt - 1 : yabai -m space --focus 1
alt - b : yabai -m space --focus 2
alt - c : yabai -m space --focus 3
alt - d : yabai -m space --focus 4
alt - e : yabai -m space --focus 5
alt - m : yabai -m space --focus 6
alt - p : yabai -m space --focus 7
alt - q : yabai -m space --focus 8
alt - t : yabai -m space --focus 9
alt - u : yabai -m space --focus 10
alt - v : yabai -m space --focus 11
alt - w : yabai -m space --focus 12
alt - x : yabai -m space --focus 13
alt - z : yabai -m space --focus 14
alt - n : yabai -m space --focus 15
alt - y : yabai -m space --focus 16

# Move window to workspace
alt + shift - 1 : yabai -m window --space 1
alt + shift - b : yabai -m window --space 2
alt + shift - c : yabai -m window --space 3
alt + shift - d : yabai -m window --space 4
alt + shift - e : yabai -m window --space 5
alt + shift - m : yabai -m window --space 6
alt + shift - p : yabai -m window --space 7
alt + shift - q : yabai -m window --space 8
alt + shift - t : yabai -m window --space 9
alt + shift - u : yabai -m window --space 10
alt + shift - v : yabai -m window --space 11
alt + shift - w : yabai -m window --space 12
alt + shift - x : yabai -m window --space 13
alt + shift - z : yabai -m window --space 14
alt + shift - n : yabai -m window --space 15
alt + shift - y : yabai -m window --space 16

# Recent workspace
alt - tab : yabai -m space --focus recent

# Service mode
alt + shift - 0x29 : skhd -m service
service < escape : skhd -m main
service < r : yabai -m space --balance; skhd -m main
service < f : yabai -m window --toggle float; skhd -m main
service < delete : yabai -m window --close; skhd -m main
service < h : yabai -m window --stack west; skhd -m main
service < j : yabai -m window --stack south; skhd -m main
service < k : yabai -m window --stack north; skhd -m main
service < l : yabai -m window --stack east; skhd -m main
service < q : skhd -m main
service < return : skhd -m main

# Reload
shift + cmd - r : ~/.config/yabai/scripts/reload.sh

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.kanata.disable-karabiner</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/libexec/disable-karabiner-grabber.sh</string>
	</array>
	<key>UserName</key>
	<string>root</string>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>20</integer>
	<key>StandardOutPath</key>
	<string>/var/log/disable-karabiner.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/disable-karabiner.log</string>
</dict>
</plist>

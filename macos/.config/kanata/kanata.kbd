(defcfg
  process-unmapped-keys yes
)

(defsrc
  caps a s d f j k l ; h
)

(defalias
  a-mod  (tap-hold 200 200 a lctl)
  s-mod  (tap-hold 200 200 s lalt)
  d-mod  (tap-hold 200 200 d lmet)
  f-mod  (tap-hold 200 200 f lsft)

  j-mod  (tap-hold 200 200 j rsft)
  k-mod  (tap-hold 200 200 k rmet)
  l-mod  (tap-hold 200 200 l ralt)
  sc-mod (tap-hold 200 200 ; rctl)
)

(deflayer base
  esc
  @a-mod
  @s-mod
  @d-mod
  @f-mod
  @j-mod
  @k-mod
  @l-mod
  @sc-mod
  h
)
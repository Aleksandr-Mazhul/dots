# EditorConfig helps maintain consistent coding styles across multiple editors and IDEs
root = true

# All files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# JavaScript, TypeScript, JSX, TSX
[*.{js,ts,tsx,jsx,mjs,cjs}]
indent_style = space
indent_size = 2
quote_type = single

# Python
[*.py]
indent_style = space
indent_size = 4

# Lua
[*.lua]
indent_style = space
indent_size = 2

# Bash
[*.{sh,bash,zsh}]
indent_style = space
indent_size = 2

# JSON, YAML
[*.{json,yaml,yml,toml}]
indent_style = space
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
